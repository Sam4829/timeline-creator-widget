{
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": ">=10"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.109.0",
    "@figma/widget-typings": "1.11.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": ">=5",
    "vite": "^8.2.0"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "dev:ui": "vite"
  },
  "figma-plugin": {
    "editorType": [
      "figma"
    ],
    "containsWidget": true,
    "id": "timeline-estimator-widget",
    "name": "Timeline Estimator Widget",
    "permissions": [
      "currentuser"
    ],
    "main": "src/main.tsx",
    "ui": "src/ui.tsx"
  }
}
